# The following Firebase Web app configuration fields are PUBLIC, not admin secrets.
# Find them in Firebase Console → Project settings → Your apps → SDK setup and configuration.
# When left empty, the UI uses local DEMO mode, not shared persistent data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Spark-only: no Cloud Functions deployment needed
# Verified business contact only; digits without +
VITE_SALON_WHATSAPP=
# Optional: enable only after registering your domain/reCAPTCHA v3 site key in Firebase App Check
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Public technical account identifier, NOT A PASSWORD. The owner types only a password in the UI.
VITE_ADMIN_LOGIN_EMAIL=
