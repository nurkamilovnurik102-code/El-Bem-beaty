{
  "name": "el-bem-beauty-2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-translations.mjs",
    "test:functions": "node --test functions/tests/functions.test.cjs",
    "verify": "npm run typecheck && npm run check:i18n && npm run test:spark && npm run test:ui-contracts && npm run test:release && npm run build",
    "test:ui-contracts": "node --test scripts/test-final-ui-contracts.cjs",
    "test:release": "node --test scripts/test-release-polish.cjs",
    "test:spark": "node --test scripts/test-spark-logic.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "i18next": "^24.2.3",
    "react-i18next": "^15.4.1",
    "firebase": "^11.6.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
