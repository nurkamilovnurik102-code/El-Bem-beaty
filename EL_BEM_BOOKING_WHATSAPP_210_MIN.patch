''} onClick={()=>setBookingMaster('onsite')}>{t("Уточнить мастера на месте")}</button></div></div><div className="booking-step"><h3><span>03</span>  {t("Выберите день и время")}</h3><label className="field">{t("Дата")} <input type="date" min={today()} value={bookingDate} onChange={e=>{setBookingDate(e.target.value);setBookingTime('')}}/></label>{!needsWhatsappBooking&&<div className="time-grid">{(bookingServices.length?displayedTimes:[]).map(t=><button key={t} className={bookingTime===t?'selected':''} onClick={()=>setBookingTime(t)}>{t}</button>)}</div>}{!bookingServices.length?<p className="hint">{t("Сначала выберите услугу.")}</p>:needsWhatsappBooking?<p className="hint">{t("Более 210 минут: дату и время согласуем через WhatsApp. Запись в Firebase не создаётся.")}</p>:!displayedTimes.length?<div><p className="hint">{t("Для выбранной даты нет доступного времени.")}</p><button type="button" className="text-link" onClick={sendBookingToWhatsapp}>{t("Согласовать через WhatsApp")} <ArrowUpRight size={15}/></button></div>:<p className="hint">{t("Выбранное время подтверждается администратором.")}</p>}</div><div className="booking-step"><h3><span>04</span>  {t("Контактные данные")}</h3><div className="two-fields"><label className="field">{t("Ваше имя")}<input value={customer.name} onChange={e=>setCustomer({...customer,name:e.target.value})} placeholder="Как к вам обращаться"/></label><label className="field">{t("Телефон")}<input value={customer.phone} onChange={e=>setCustomer({...customer,phone:e.target.value})} placeholder="+996 555 123 456"/></label></div><label className="field">{t("Комментарий")}<textarea rows={3} value={customer.note} onChange={e=>setCustomer({...customer,note:e.target.value})} placeholder="Если есть пожелания"/></label><label className="consent"><input type="checkbox" checked={consent} onChange={e=>setConsent(e.target.checked)}/>  {t("Согласен(на) на обработку предоставленных контактных данных для записи")}</label>{needsWhatsappBooking&&<p className="hint">{t("Для длительных процедур свяжитесь с салоном. Сообщение нужно отправить в WhatsApp вручную.")}</p>}<button className="btn btn-primary" disabled={bookingBusy} onClick={needsWhatsappBooking?sendBookingToWhatsapp:submitBooking}>{needsWhatsappBooking?t("Согласовать через WhatsApp"):t("Отправить заявку")} <ArrowUpRight size={17}/></button></div></div><aside className="booking-summary"><div className="eyebrow">{t("ВАША ЗАПИСЬ")}</div><h3>{t("Красота в деталях")}</h3><div>{picked.length?picked.map(s=><div className="summary-row" key={s.id}><span>{itemText(s,'name',s.name)}</span><b>{money(s.price)}</b></div>):<p>{t("Услуги ещё не выбраны")}</p>}</div><div className="summary-row"><span>{t("Длительность")}</span><b>{duration}  {t("мин")}</b></div><div className="summary-row"><span>{t("Дата / время")}</span><b>{bookingDate} {needsWhatsappBooking?t("Время согласовывается"):bookingTime}</b></div><div className="summary-total"><span>{t("Ориентировочно")}</span><strong>{t("от")} {money(total)}</strong></div><small>{t("Стоимость может измениться после консультации.")}</small></aside></div>}</Section>;
  const ShopPage=()=> <Section eyebrow="BEAUTY SHOP" title="Красота в каждом дне">{!content.shopEnabled?<p>{t("Магазин временно недоступен.")}</p>:<><div className="filter-bar"><SearchField value={query} onChange={setQuery} placeholder={t("Поиск товара")}/><div className="chips">{productCategories.map(c=><button className={productCat===c?'selected':''} key={c} onClick={()=>setProductCat(c)}>{c==='Все'?t(c):itemText(state.categories.find(x=>x.name===c),'name',c)}</button>)}</div></div><div className="card-grid">{activeProducts.filter(p=>(productCat==='Все'||p.category===productCat)&&p.name.toLowerCase().includes(query.toLowerCase())).map(p=><article className="service-card" key={p.id}><button type="button" className="card-photo detail-photo-button" onClick={()=>openDetail('product',p.id)} aria-label={`Подробнее о товаре: ${itemText(p,'name',p.name)}`}><MediaImage src={p.image} alt={itemText(p,'name',p.name)} loading="lazy"/></button><div className="card-body"><div className="muted small">{itemText(p,'category',p.category)}</div><button type="button" className="detail-title" onClick={()=>openDetail('product',p.id)}><h3>{itemText(p,'name',p.name)}</h3></button><div className="card-bottom"><strong>{money(p.price)}</strong><button className={`product-add-btn ${addedProductId===p.id?'is-added':''}`} onClick={()=>addProduct(p)} aria-label={`В корзину: ${itemText(p,'name',p.name)}`} aria-live="polite">{addedProductId===p.id?<><Check size={18}/><span>{t('Добавлено')}</span></>:<ShoppingCart size={18}/>}</button></div></div></article>)}</div></>}</Section>;
  const AccountPage=()=> <Section eyebrow="ЛИЧНЫЙ КАБИНЕТ" title="Мой профиль">{!authUser?<div className="account-panel"><Lock size={26}/><p>Доступ к личному кабинету открыт только зарегистрированным клиентам. Создайте аккаунт или войдите, чтобы видеть свои записи и заказы.</p><button className="btn btn-primary" onClick={()=>{setAuthMode('login');setAuthOpen(true)}}>Войти в кабинет</button><button className="btn btn-outline" onClick={()=>{setAuthMode('signup');setAuthOpen(true)}}>Регистрация</button></div>:<div className="account-panel"><p>Вы вошли как <strong>{authUser.email}</strong></p><button className="text-link" onClick={()=>auth&&void signOut(auth)}>Выйти из аккаунта</button><h3>Мои записи</h3>{myBookings.length?myBookings.map(b=><div className="account-item" key={b.id}><b>{b.date} · {b.time}</b><span>{b.serviceIds.map((id,index)=>b.serviceNames?.[index]||state.services.find(x=>x.id===id)?.name||id).join(', ')}</span><small>Статус: {b.status}</small></div>):<p>Пока нет записей в этом аккаунте. Гостевые заявки не привязываются автоматически к профилю.</p>}<h3>Мои заказы</h3>{myOrders.length?myOrders.map(o=><div className="account-item" key={o.id}><b>Заказ #{o.id.slice(0,8)}</b><span>{money(o.total)}</span></div>):<p>Пока нет заказов.</p>}</div>}</Section>;
  const DetailsPage=()=>{const item=detail?.type==='service'?state.services.find(s=>s.id===detail.id):detail?.type==='product'?state.products.find(p=>p.id===detail.id):state.masters.find(m=>m.id===detail?.id);if(!detail||!item)return <Section eyebrow="ИНФОРМАЦИЯ" title="Не найдено"><button className="btn btn-outline" onClick={()=>go('Главная')}>{t("На главную")}</button></Section>;const isService=detail.type==='service',isProduct=detail.type==='product',asService=isService?item as Service:null,asProduct=isProduct?item as Product:null,asMaster=detail.type==='master'?item as Master:null;return <Section eyebrow={isService?'ПОДРОБНО ОБ УСЛУГЕ':isProduct?'ПОДРОБНО О ТОВАРЕ':'НАШ МАСТЕР'} title={itemText(item,'name',item.name)}><div className="detail-layout"><div className="detail-visual"><MediaImage src={item.image} alt={itemText(item,'name',item.name)}/></div><div className="detail-info"><div className="eyebrow">{asService?.category||asProduct?.category||asMaster?.specialty}</div><p className="lead">{asService?itemText(asService,'description',asService.description):asProduct?itemText(asProduct,'description',asProduct.description):asMaster?itemText(asMaster,'specialty',asMaster.specialty):t('Описание обновляется администратором.')}</p>{asService&&<><p><b>{t("Продолжительность:")}</b> {asService.duration}  {t("мин")}</p><h3>{t("Стоимость от")} {money(asService.price)}</h3><p className="hint">{t("Фактическая цена уточняется после консультации.")}</p><button className="btn btn-primary" onClick={()=>{setBookingServices([asService.id]);go('Запись')}}>{t("Записаться на услугу")} <ArrowUpRight size={17}/></button></>}{asProduct&&<><h3>{money(asProduct.price)}</h3><button className={`btn btn-primary ${addedProductId===asProduct.id?'cart-added':''}`} onClick={()=>addProduct(asProduct)}>{addedProductId===asProduct.id?t('Добавлено'):t('В корзину')} {addedProductId===asProduct.id?<Check size={17}/>:<ShoppingCart size={17}/>}</button></>}{asMaster&&<><h3>{t("Услуги мастера")}</h3><div className="detail-services">{state.services.filter(s=>asMaster.serviceIds.includes(s.id)).map(s=><button key={s.id} onClick={()=>openDetail('service',s.id)}>{itemText(s,'name',s.name)} <ArrowUpRight size={15}/></button>)}</div><button className="btn btn-primary" onClick={()=>{setBookingMaster(asMaster.id);go('Запись')}}>{t("Записаться к мастеру")} <ArrowUpRight size={17}/></button></>}<button className="text-link" onClick={()=>go(isService?'Услуги':isProduct?'Магазин':'Мастера')}>{t("← Вернуться к списку")}</button></div></div></Section>};
